void UpdatePenState(double h, double l, double o, double c)
{
   bool isYang = (c > o);
   bool isYin  = (c < o);
   if(!isYang && !isYin) return;
   
   double max_sl_dist = InpMaxSL * _Point;


   // 1. 初始化第一根笔
   if(m_pen_type == PEN_NONE) {
      m_pen_type = isYang ? PEN_YANG : PEN_YIN;
      m_pen_top = h; m_pen_bottom = l;
      return;
   }

   // 2. 颜色发生反转：代表当前笔结束，开启新笔
   if((m_pen_type == PEN_YANG && isYin) || (m_pen_type == PEN_YIN && isYang))  
   {
   
// // --- 正确获取 ATR 数值的逻辑 ---
