void ClosePositionsByType(ENUM_POSITION_TYPE type)
{
   bool isMainClosed = false;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket) && PositionGetString(POSITION_SYMBOL) == _Symbol)
      {
         // 检查仓位类型
         if(PositionGetInteger(POSITION_TYPE) == type) 
         {
         
            // 记录主力单被成功平仓
            string comment = PositionGetString(POSITION_COMMENT);
            if(StringFind(comment, "Hedge") < 0) {
              isMainClosed = true; 
            }; 
            
            m_trade.PositionClose(ticket);
         }
      }
      
      // 2. 如果主力单平仓成功，寻找对冲单并把止损推到区间边缘
   if(isMainClosed)
   {
      // 获取遗留对冲单的方向（与刚刚平仓的主力单相反）
      ENUM_POSITION_TYPE hedge_type = (type == POSITION_TYPE_BUY) ? POSITION_TYPE_SELL : POSITION_TYPE_BUY;
      
      // 【修改点1】：对冲空单放区间下沿，对冲多单放区间上沿
      double target_sl = (type == POSITION_TYPE_BUY) ? m_curr_zone.bottom : m_curr_zone.top;
      target_sl = NormalizeDouble(target_sl, _Digits);

      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(PositionSelectByTicket(ticket) && PositionGetString(POSITION_SYMBOL) == _Symbol)
         {
            if(PositionGetInteger(POSITION_TYPE) == hedge_type)
            {
               string comment = PositionGetString(POSITION_COMMENT);
               if(StringFind(comment, "Hedge") >= 0)
               {
                  double current_sl = PositionGetDouble(POSITION_SL);
                  double current_price = PositionGetDouble(POSITION_PRICE_CURRENT);

                  // 针对遗留的对冲空单：MT5要求空单止损价格必须高于当前价格
                  if(hedge_type == POSITION_TYPE_SELL && target_sl > current_price)
                  {
                     // 只在原本无止损，或者新止损可以使风险更小（止损下移）时修改
                     if(current_sl == 0 || target_sl < current_sl)
                     {
                        // 【修改点2】：止盈参数直接传 0，不再使用 current_tp
                        if(m_trade.PositionModify(ticket, target_sl, 0))
                        {
                           PrintFormat("【对冲保护】主力多单离场，遗留对冲空单止损设至区间底: %.5f", target_sl);
                        }
                     }
                  }
                  // 针对遗留的对冲多单：MT5要求多单止损价格必须低于当前价格
                  else if(hedge_type == POSITION_TYPE_BUY && target_sl < current_price)
                  {
                     // 只在原本无止损，或者新止损可以使风险更小（止损上移）时修改
                     if(current_sl == 0 || target_sl > current_sl)
                     {
                        // 【修改点2】：止盈参数直接传 0，不再使用 current_tp
                        if(m_trade.PositionModify(ticket, target_sl, 0))
                        {
                           PrintFormat("【对冲保护】主力空单离场，遗留对冲多单止损设至区间顶: %.5f", target_sl);
                        }
                     }
                  }
                  else
                  {
                     // 增加一个隐藏拦截提示，如果价格太贴近区间边缘导致 MT5 报错不让设止损，可以在日志里看到原因
                     PrintFormat("【警告】价格限制导致对冲单止损修改跳过：目标止损=%.5f, 当前价=%.5f", target_sl, current_price);
                  }
               }
            }
         }
      }}
      
   }
}

bool HasPositionByType(ENUM_POSITION_TYPE type)
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket))
      {
         // 1. 检查交易品种
         if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
         
         // 2. 检查仓位类型（买/卖）
         if(PositionGetInteger(POSITION_TYPE) != type) continue;
         
         // --- 新增：排除对冲单 ---
         // 3. 如果注释中包含 "Hedge"，直接跳过，不计入持仓判断
         //string comment = PositionGetString(POSITION_COMMENT);
         //if(StringFind(comment, "Hedge") >= 0) continue;
         
         // 如果通过了以上所有过滤，说明存在符合条件的正向单
         return true; 
      }
   }
   return false;
}

// 获取指定类型的挂单价格。如果没有挂单，返回 -1
double GetExistingOrderPrice(ENUM_ORDER_TYPE type)
{
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(OrderSelect(ticket))
      {
         if(OrderGetInteger(ORDER_TYPE) == type && OrderGetString(ORDER_SYMBOL) == _Symbol)
         {
            return OrderGetDouble(ORDER_PRICE_OPEN);
         }
      }
   }
   return -1;
}

//+------------------------------------------------------------------+
//| 检查连续 K 线脱离区间逻辑                                           |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| 增强版：检查连续 K 线脱离区间逻辑（集成 RSI 动量过滤）                 |
//+------------------------------------------------------------------+
void CheckContinuousBreakout(double h, double l, double c, double o)
{
   // 1. 基础安全检查
   if(!m_zone_initialized) return;

   bool isYang = (c > o);
   bool isYin  = (c < o);
   
   // --- 获取 ATR 数值 (用于原始波幅过滤) ---
   double atr_buffer[1];
   double current_atr = 0;
   if(CopyBuffer(m_atr_handle, 0, 1, 1, atr_buffer) > 0) {
      current_atr = atr_buffer[0];
   }
   
   // --- 获取 RSI 数值 (新增：动量过滤) ---
   double rsi_buffer[1];
   if(CopyBuffer(m_rsi_handle, 0, 1, 1, rsi_buffer) <= 0) {
      Print("【警告】无法获取 RSI 数据，跳过逻辑检查");
      return; 
   }
   double current_rsi = rsi_buffer[0];


   // 笔长度过滤逻辑（保持你原来的逻辑）
   double pen_size = h - l;
   double pen_size_1 = m_pen_top - m_pen_bottom;

   double max_sl_dist = InpMaxSL * _Point;


   
   // 2. 位置计数逻辑
   // --- 逻辑 A：区间上方连续不回 ---
   if(l > m_curr_zone.top) 
   {
      if((pen_size > current_atr && isYang) || (m_pen_type == PEN_YANG &&  pen_size_1 > current_atr  * InpATRMultiplier)){
         m_count_above_zone++;
         m_count_below_zone = 0; 
         PrintFormat("【计数】价格在区间上方，连续第 %d 根 | 当前 RSI: %.2f", m_count_above_zone, current_rsi);
      }
   }
   // --- 逻辑 B：区间下方连续不回 ---
   else if(h < m_curr_zone.bottom) 
   {
      if((pen_size > current_atr && isYin) || (m_pen_type == PEN_YIN &&  pen_size_1 > current_atr * InpATRMultiplier)){
         m_count_below_zone++;
         m_count_above_zone = 0; 
         PrintFormat("【计数】价格在区间下方，连续第 %d 根 | 当前 RSI: %.2f", m_count_below_zone, current_rsi);
      }
   }
   // --- 逻辑 C：价格回到了区间内 ---
   else
   {
      m_count_above_zone = 0;
      m_count_below_zone = 0;
   }

   // 3. 执行交易决策
   // --- 情况一：连续 2 根在上方（看多） ---
   if(m_count_above_zone >= Inout_count)
   {
       PrintFormat("【信号触发】强趋势+RSI动量确认(%.2f)，准备多单", current_rsi);
       ClosePositionsByType(POSITION_TYPE_SELL);
         
       // 锁定防线
     //  m_locked_buy_edge = m_curr_zone.top;
       
         
      // --- 核心过滤：RSI 必须显示向上动量 ---
      if(current_rsi > InpRSI_Upper) 
      {
     
      
         // 均线过滤检查
         bool ma_ok = true;
         if(InpUseMAFilter && m_ma_handle != INVALID_HANDLE) {
            double ma[1];
            if(CopyBuffer(m_ma_handle, 0, 1, 1, ma) > 0) {
               if(c <= ma[0]) ma_ok = false; 
            }
         }
            
         if(ma_ok 
         && !HasPositionByType(POSITION_TYPE_BUY)
          && IsBollingerExpanding() )
         {
            double aa = NormalizeDouble(c - m_curr_zone.top, _Digits);
            if((m_count_up_zones == 0 && aa < 2 * InPy) || (aa < InPy && m_count_up_zones < 4)) {
              // 锁定防线
               m_locked_buy_edge = m_curr_zone.top;
              
              // 只开主力多单，不开对冲
               if(m_trade.Buy(InpLots, _Symbol, c, 0, 0, "Main_Order")) 
               {
                CloseAllPositionsByComment("Hedge");
                  PrintFormat("【下单成功】开多单，锁定防线: %.5f", m_locked_buy_edge);
                  m_count_above_zone = 0; 
               }
            } else {
               PrintFormat("【跳过】价格距离区间边缘 %.5f 超过 InPy 限制", aa);
            }
         }
      }
      else {
         PrintFormat("【过滤】虽脱离区间但 RSI(%.2f) 未超55，动力不足", current_rsi);
      }
   }

   // --- 情况二：连续 2 根在下方（看空） ---
   if(m_count_below_zone >= Inout_count)
   {
        PrintFormat("【信号触发】强趋势+RSI动量确认(%.2f)，准备空单", current_rsi);
         ClosePositionsByType(POSITION_TYPE_BUY);
       
      
        // 锁定防线
      //  m_locked_sell_edge = m_curr_zone.bottom;
       
       
       
      // --- 核心过滤：RSI 必须显示向下动量 ---
      if(current_rsi < InpRSI_Lower) 
      {
   
         bool ma_ok = true;
         if(InpUseMAFilter && m_ma_handle != INVALID_HANDLE) {
            double ma[1];
            if(CopyBuffer(m_ma_handle, 0, 1, 1, ma) > 0) {
               if(c >= ma[0]) ma_ok = false; 
            }
         }
            
         if(ma_ok
          && !HasPositionByType(POSITION_TYPE_SELL) 
          && IsBollingerExpanding() )
         {
            double aa = NormalizeDouble(m_curr_zone.bottom - c, _Digits);
            if((m_count_down_zones == 0 && aa < 2 * InPy) || (aa < InPy && m_count_down_zones < 4)) {
              // 锁定防线
                 m_locked_sell_edge = m_curr_zone.bottom;
         
                 // 只开主力空单，不开对冲
                 if(m_trade.Sell(InpLots, _Symbol, c, 0, 0, "Main_Order")) 
                 {
                    CloseAllPositionsByComment("Hedge");
                     PrintFormat("【下单成功】开空单，锁定防线: %.5f", m_locked_sell_edge);
                     m_count_below_zone = 0; 
                 }
            } else {
               PrintFormat("【跳过】价格距离区间边缘 %.5f 超过 InPy 限制", aa);
            }
         }
      }
      else {
         PrintFormat("【过滤】虽脱离区间但 RSI(%.2f) 未跌破45，动力不足", current_rsi);
      }
      
   }
}

void OnDeinit(const int reason) {
    if(m_atr_handle != INVALID_HANDLE) IndicatorRelease(m_atr_handle);
    if(m_ma_handle != INVALID_HANDLE) IndicatorRelease(m_ma_handle);
    if(m_rsi_handle != INVALID_HANDLE) IndicatorRelease(m_rsi_handle);
    if(m_bb_handle != INVALID_HANDLE) IndicatorRelease(m_bb_handle);
}

bool IsBollingerExpanding(int period = 5)
{
    double upper[], lower[];
    ArraySetAsSeries(upper, true);
    ArraySetAsSeries(lower, true);

    // 1. 获取最近 N 周期的布林带数据 (用于计算平均带宽)
    int bars_to_copy = period; 
    if(CopyBuffer(m_bb_handle, 1, 0, bars_to_copy, upper) <= 0) return false;
    if(CopyBuffer(m_bb_handle, 2, 0, bars_to_copy, lower) <= 0) return false;

    // 2. 计算当前带宽
    double current_width = upper[0] - lower[0];

    // 3. 计算过去 N 周期的平均带宽
    double sum_width = 0;
    for(int i = 0; i < bars_to_copy; i++)
    {
        sum_width += (upper[i] - lower[i]);
    }
    double average_width = sum_width / bars_to_copy;

    bool is_expanding = current_width > (average_width * 1.1);
    bool is_growing = (upper[0] - lower[0]) > (upper[1] - lower[1]);

   PrintFormat("【boll】最新：%.2f ，前：%.2f", (upper[0] - lower[0]), (upper[1] - lower[1]));
    return (is_growing);
}