#property strict
#include <Trade\Trade.mqh>

//--- 外部参数 ---
input double InpLots = 0.01;      // 交易手数
input int    InPy = 10;
input double InpATRMultiplier = 1;  // ATR 倍数 (信号笔长度需大于此值)
input int    InpMAPeriod      = 360;             // 均线周期

int    InpMaxSL = 10000;     // 最大止损距离 (单位: 点/Points)
int    InpATRPeriod = 14;       // ATR 周期 (用于过滤震荡)


//--- 交易对象 ---
CTrade m_trade;                    

//--- 【笔结构定义】 ---
enum ENUM_PEN_TYPE { PEN_NONE, PEN_YANG, PEN_YIN }; 
ENUM_PEN_TYPE m_pen_type = PEN_NONE;    // 当前笔的属性（阳/阴/无）
double m_pen_top = 0.0;                 // 当前笔记录的最高价
double m_pen_bottom = 0.0;              // 当前笔记录的最低价

//--- 【区间结构定义】 ---
struct Zone { double top; double bottom; };         

// 统一使用压缩区间
Zone m_curr_zone = {0, 0};              // 当前有效的压缩区间（核心参考区）
Zone m_prev_zone = {0, 0};              // 上一个压缩区间

bool m_zone_initialized = false;        // 区间是否已完成首次初始化

//--- 【信号变量】 ---
int m_signal_ready = 0;   // 信号状态：1为预备做多，-1为预备做空，0为无信号
datetime m_last_bar_time = 0; // 用于检测新 K 线

//--- 连续 K 线计数器 ---
int m_count_above_zone = 0; // 连续在区间上方的计数
int m_count_below_zone = 0; // 连续在区间下方的计数

int m_atr_handle = INVALID_HANDLE; // 存储 ATR 指标句柄

bool   InpUseMAFilter   = true;          // 启用均线过滤
int    InpMAShift       = 0;               // 均线偏移
ENUM_MA_METHOD InpMAMethod = MODE_SMA;     // 均线类型：简单移动平均
ENUM_APPLIED_PRICE InpMAAppliedPrice = PRICE_CLOSE; // 应用于收盘价
int m_ma_handle = INVALID_HANDLE; // 均线指标句柄


//--- 外部参数 ---
int InpRSI_Period = 14;      // RSI 周期
int InpRSI_Upper  = 45;      // 做多阈值 (RSI 需大于此值)
int InpRSI_Lower  = 55;      // 做空阈值 (RSI 需小于此值)

int Inout_count = 1; //脱离k线

//--- 全局变量 ---
int m_rsi_handle = INVALID_HANDLE; // RSI 句柄


// --- 外部参数 ---
int InpBBPeriod = 20;      // 布林带周期
double InpBBDev = 2.0;     // 标准差倍数

// --- 全局变量 ---
int m_bb_handle = INVALID_HANDLE;

//--- 区间变换计数器 ---
int m_count_up_zones = 0;   // 连续向上变换区间的次数
int m_count_down_zones = 0; // 连续向下变换区间的次数


//--- 焊死防线变量 ---
double m_locked_buy_edge = 0;  // 记录多单入场时的区间顶
double m_locked_sell_edge = 0; // 记录空单入场时的区间底

//+------------------------------------------------------------------+
//| 初始化函数                                                        |
//+------------------------------------------------------------------+
int OnInit() {
// 创建 ATR 句柄：品种、周期、平均周期
   m_atr_handle = iATR(_Symbol, PERIOD_CURRENT, InpATRPeriod);
   
   if(m_atr_handle == INVALID_HANDLE) {
      Print("ATR 句柄创建失败！");
      return(INIT_FAILED);
   }
   
      // 创建均线句柄
   if(InpUseMAFilter) {
      m_ma_handle = iMA(_Symbol, PERIOD_CURRENT, InpMAPeriod, InpMAShift, InpMAMethod, InpMAAppliedPrice);
      if(m_ma_handle == INVALID_HANDLE) {
         Print("均线句柄创建失败！");
         return(INIT_FAILED);
      }
   }
   
   // 创建 RSI 句柄
   m_rsi_handle = iRSI(_Symbol, PERIOD_CURRENT, InpRSI_Period, PRICE_CLOSE);
   if(m_rsi_handle == INVALID_HANDLE) {
      Print("RSI 句柄创建失败！");
      return(INIT_FAILED);
   }
   
   // --- OnInit() 中初始化 ---
   m_bb_handle = iBands(_Symbol, PERIOD_CURRENT, InpBBPeriod, 0, InpBBDev, PRICE_CLOSE);

   return(INIT_SUCCEEDED);
 }

//+------------------------------------------------------------------+
//| 主循环函数                                                        |
//+------------------------------------------------------------------+
void OnTick()
{
   // --- 每秒/每点检查移动止损 (锁定1/3盈利) ---
   // ApplyTrailingStop();
   ApplyBreakEvenByATR();
   

   datetime current_time = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(current_time != m_last_bar_time)
   {
      // 获取上一根已收盘 K 线的数据
      double last_high  = iHigh(_Symbol, PERIOD_CURRENT, 1);
      double last_low   = iLow(_Symbol, PERIOD_CURRENT, 1);
      double last_open  = iOpen(_Symbol, PERIOD_CURRENT, 1);
      double last_close = iClose(_Symbol, PERIOD_CURRENT, 1);

      // 更新笔的状态和压缩区间
      UpdatePenState(last_high, last_low, last_open, last_close);
      
              // 2. 新增：连续 3 根 K 线不回区间检测逻辑
      CheckContinuousBreakout(last_high, last_low, last_close, last_open);

      m_last_bar_time = current_time;
   }
}

//+------------------------------------------------------------------+
//| 核心逻辑：执行“免费期权”转换与区间回撤保护                           |
//+------------------------------------------------------------------+
void ApplyBreakEvenByATR()
{
   // 1. 获取最新 ATR 数据
   double atr_buffer[1];
   if(CopyBuffer(m_atr_handle, 0, 1, 1, atr_buffer) <= 0) return;
   double current_atr = atr_buffer[0];
   double cur_price = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   // 2. 遍历所有持仓
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(!PositionSelectByTicket(ticket) || PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      
      string comment = PositionGetString(POSITION_COMMENT);
      if(StringFind(comment, "Hedge") >= 0) continue; 

      double entry_price = PositionGetDouble(POSITION_PRICE_OPEN);
      double cur_sl      = PositionGetDouble(POSITION_SL);
      ENUM_POSITION_TYPE type = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);

      //---------------------------------------------------------
      // 情况一：主力做多单 (POSITION_TYPE_BUY)
      //---------------------------------------------------------
      if(type == POSITION_TYPE_BUY)
      {
         // --- 场景 A：防守（跌回锁定的区间边缘 → 开对冲单） ---
         if(m_locked_buy_edge > 0 && cur_price <= m_locked_buy_edge)
         {
            if(!HasPositionByType(POSITION_TYPE_SELL))
            {
               m_trade.Sell(InpLots, _Symbol, cur_price, 0, 0, "Hedge");
               PrintFormat("【触发对冲】价格回到防线 %.5f，开空单对冲", m_locked_buy_edge);
            }
         }

          //--- 场景 C：一阶保本（2倍ATR触发，止损到入场价，平对冲） ---
         else 
         {
            double target_2atr = entry_price + (2.0 * current_atr);
            if(cur_price >= target_2atr)
            {
               double new_sl = NormalizeDouble(entry_price, _Digits);
               if(cur_sl < new_sl)
               {
                  if(m_trade.PositionModify(ticket, new_sl, 0))
                  {
                     Print("【一阶保本】触碰2倍ATR，止损移至入场价，平掉对冲单");
                     //CloseAllPositionsByComment("Hedge");
                     m_locked_buy_edge = 0;
                  }
               }
            }
         }
      }
      
      //---------------------------------------------------------
      // 情况二：主力做空单 (POSITION_TYPE_SELL)
      //---------------------------------------------------------
      else if(type == POSITION_TYPE_SELL)
      {
         // --- 场景 A：防守（涨回锁定区间边缘 → 开对冲单） ---
         if(m_locked_sell_edge > 0 && cur_price >= m_locked_sell_edge)
         {
            if(!HasPositionByType(POSITION_TYPE_BUY))
            {
               m_trade.Buy(InpLots, _Symbol, cur_price, 0, 0, "Hedge");
               PrintFormat("【触发对冲】价格回到防线 %.5f，开多单对冲", m_locked_sell_edge);
            }
         }

         // --- 场景 C：一阶保本 ---
         else 
         {
            double target_2atr = entry_price - (2.0 * current_atr);
            if(cur_price <= target_2atr)
            {
               double new_sl = NormalizeDouble(entry_price, _Digits);
               if(cur_sl == 0 || cur_sl > new_sl)
               {
                  if(m_trade.PositionModify(ticket, new_sl, 0))
                  {
                     Print("【一阶保本】触碰2倍ATR，止损移至入场价，平掉对冲单");
                     //CloseAllPositionsByComment("Hedge");
                     m_locked_sell_edge = 0;
                  }
               }
            }
         }
      }
   }
}


//+------------------------------------------------------------------+
//| 辅助函数：根据注释平掉所有对应的单子                               |
//+------------------------------------------------------------------+
void CloseAllPositionsByComment(string target_comment)
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket) && PositionGetString(POSITION_SYMBOL) == _Symbol)
      {
         string comment = PositionGetString(POSITION_COMMENT);
         if(StringFind(comment, target_comment) >= 0)
         {
            m_trade.PositionClose(ticket);
         }
      }
   }
}

bool havaPositionsByComment(string target_comment)
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket) && PositionGetString(POSITION_SYMBOL) == _Symbol)
      {
         string comment = PositionGetString(POSITION_COMMENT);
         if(StringFind(comment, target_comment) >= 0)
         {
            return true;
         }
      }
   }
   return false;
}

//+------------------------------------------------------------------+
//| 笔完成时的区间处理逻辑（当K线颜色反转时触发）                       |
//+------------------------------------------------------------------+
void OnPenCompleted()
{

   // 计算新完成的笔与当前区间的交集（压缩逻辑）
   double intersect_top = MathMin(m_curr_zone.top, m_pen_top);
   double intersect_bottom = MathMax(m_curr_zone.bottom, m_pen_bottom);
   
   if(intersect_top > intersect_bottom) {
     PrintFormat("【区间监控】当前压缩区间: Top=%.5f, Bottom=%.5f", intersect_top, intersect_bottom);
  
      // 存在交集，更新压缩区间边界
      m_curr_zone.top = intersect_top;
      m_curr_zone.bottom = intersect_bottom;
      m_signal_ready = 0; // 区间内波动，清空信号
   }  
   else {
      // 无交集，判断是否产生突破预备信号
      if(m_pen_type == PEN_YIN && m_pen_bottom > m_curr_zone.top) {
         m_signal_ready = 1;  
         PrintFormat("【预备】阴笔未入压缩区（在上方），等待转阳做多。m_pen_bottom=%.5f, m_curr_zone.top=%.5f", m_pen_bottom, m_curr_zone.top);
      }  
      else if(m_pen_type == PEN_YANG && m_pen_top < m_curr_zone.bottom) {
         m_signal_ready = -1; 
         PrintFormat("【预备】阳笔未入压缩区（在下方），等待转阴做空。m_pen_top=%.5f, m_curr_zone.bottom=%.5f", m_pen_top, m_curr_zone.bottom);
      }  
   }
}


//+------------------------------------------------------------------+
//| 辅助函数：检查是否有指定类型的挂单                                  |
//+------------------------------------------------------------------+
bool HasOrderByType(ENUM_ORDER_TYPE type)
{
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(OrderSelect(ticket))
      {
         if(OrderGetString(ORDER_SYMBOL) == _Symbol && OrderGetInteger(ORDER_TYPE) == type)
            return true;
      }
   }
   return false;
}

//+------------------------------------------------------------------+
//| 辅助函数：根据类型删除未成交的挂单                                  |
//+------------------------------------------------------------------+
void DeleteOrdersByType(ENUM_ORDER_TYPE type)
{
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(OrderSelect(ticket))
      {
         if(OrderGetString(ORDER_SYMBOL) == _Symbol && OrderGetInteger(ORDER_TYPE) == type)
         {
            m_trade.OrderDelete(ticket);
         }
      }
   }
}

