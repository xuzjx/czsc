      double current_atr = 0;
      
      // 复制最新的 ATR 数据（索引为 0 或 1，通常取已完成的 K 线索引 1）
      if(CopyBuffer(m_atr_handle, 0, 1, 1, atr_buffer) > 0) {
         current_atr = atr_buffer[0];
      }
      
      double pen_size = m_pen_top - m_pen_bottom;
      
      // 过滤：如果笔的波动幅度小于 ATR * 倍数，则视为杂波
      if(current_atr > 0 && pen_size < current_atr * InpATRMultiplier) {
         PrintFormat("【过滤】笔长度 %.5f < ATR阈值 %.5f，忽略此笔", pen_size, current_atr * InpATRMultiplier);
         m_pen_type = isYang ? PEN_YANG : PEN_YIN;
         m_pen_top = h; m_pen_bottom = l;
